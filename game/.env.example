# Copy to .env.local and fill in your Supabase project credentials.
# If left empty, scores will be stored in localStorage as a fallback.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Socket.io server URL (default: http://localhost:8080)
VITE_SOCKET_URL=http://localhost:8080

# Admin authentication is server-only. Open /admin.html and use the password
# configured as ADMIN_PASSWORD_HASH (recommended) or ADMIN_PASSWORD on Node.
